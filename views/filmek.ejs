<%- include("partials/header") %>
<div id="main">
	<div class="inner">
        <section class="tiles">
            <% filmek.forEach( film => { %>
                <article class="style3">
                    <span class="image">
                        <img src="/img/fuggony.jpeg"></img>
                    </span>
                    <a href="#">
                        <h2><%= film.filmcim %></h2>
                        <div class="content">
                            <p><%= film.mufaj %></p>
                        </div>
                    </a>
                </article>
            <% }) %>
        </section>
    </div>
</div>
<%- include("partials/footer") %>